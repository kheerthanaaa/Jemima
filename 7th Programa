Program 7: Bayesian Network (pgmp)

from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination

model = DiscreteBayesianNetwork([('T', 'S'), ('S', 'F')])   # T -> S -> F
model.add_cpds(
    TabularCPD('T', 2, [[0.7], [0.3]], state_names={'T': ['Normal', 'High']}),
    TabularCPD('S', 2, [[0.9, 0.4], [0.1, 0.6]], evidence=['T'], evidence_card=[2],
               state_names={'S': ['No', 'Yes'], 'T': ['Normal', 'High']}),
    TabularCPD('F', 2, [[0.9, 0.2], [0.1, 0.8]], evidence=['S'], evidence_card=[2],
               state_names={'F': ['No', 'Yes'], 'S': ['No', 'Yes']})
)
print("Model valid:", model.check_model())

infer = VariableElimination(model)
print("\nProbability of Fever given High Temp:")
print(infer.query(['F'], evidence={'T': 'High'}))
